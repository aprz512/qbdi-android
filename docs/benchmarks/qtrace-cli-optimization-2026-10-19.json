    "scope": "Local Linux Frida suspended process and full fixed agent; no tracer startup request; not Android performance or device transport-loss delivery.",
    "source": "import json, os, platform, signal, sys, threading, time\nfrom pathlib import Path\nimport frida\n\nresult = {'frida_version': frida.__version__, 'platform': platform.platform(),\n          'method': 'Actual Frida local suspended process and repository agent; no tracer request is posted.'}\ndevice = frida.get_local_device()\npid = device.spawn([sys.executable, '-c', 'import time; time.sleep(30)'])\npidfd = os.pidfd_open(pid)\nsession = None\nterminated = threading.Event()\nstarted = time.monotonic()\ntry:\n    result['pid'] = pid\n    session = device.attach(pid)\n    def detached(reason, *details):\n        result['detached_reason'] = reason\n        result['detached_ms'] = (time.monotonic() - started) * 1000\n        terminated.set()\n    session.on('detached', detached)\n    script = session.create_script(Path('qtrace/agent.js').read_text())\n    script.load()\n    try:\n        result['rpc_response'] = script.exports_sync.qtrace_abort()\n    except Exception as error:\n        result['rpc_error'] = type(error).__name__ + ': ' + str(error)\n    result['terminated'] = terminated.wait(2)\n    result['passed'] = result['terminated'] and result.get('detached_reason') == 'process-terminated'\nfinally:\n    try:\n        signal.pidfd_send_signal(pidfd, signal.SIGKILL)\n    except ProcessLookupError:\n        pass\n    os.close(pidfd)\n    if session is not None:\n        try: session.detach()\n        except Exception: pass\nprint(json.dumps(result, indent=2))\nif not result.get('passed'): raise SystemExit(1)\n"
  },
