{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qtrace-ui",
  "version": "0.1.0",
  "identifier": "com.qbdi.qtrace-ui",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../src-web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../src-web"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "qtrace-ui",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
