{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qtrace-ui",
  "version": "0.1.0",
  "identifier": "com.qbdi.qtrace-ui",
  "build": {
    "features": ["desktop"],
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../src-web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../src-web"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "qtrace-ui",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
